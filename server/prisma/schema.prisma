generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model PublicPost {
  id             String        @id
  mediaUrl       String        @map("media_url")
  mediaType      String        @map("media_type")
  title          String
  message        String
  senderName     String        @map("sender_name")
  theme          String        @default("minimal-light")
  expiryAt       DateTime?     @map("expiry_at")
  passwordHash   String?       @map("password_hash")
  stampId        String?       @map("stamp_id")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  @@index([createdAt])
  @@map("public_posts")
}

model PrivateSpace {
  id          String         @id
  createdAt   DateTime       @default(now()) @map("created_at")
  postcards   PrivatePost[]

  @@map("private_spaces")
}

model PrivatePost {
  id             String        @id
  spaceId        String        @map("space_id")
  mediaUrl       String        @map("media_url")
  mediaType      String        @map("media_type")
  title          String
  message        String
  recipientName  String        @map("recipient_name")
  senderName     String        @map("sender_name")
  theme          String        @default("minimal-light")
  expiryAt       DateTime?     @map("expiry_at")
  passwordHash   String?       @map("password_hash")
  stampId        String?       @map("stamp_id")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  space          PrivateSpace  @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  @@index([spaceId, createdAt])
  @@map("private_posts")
}
